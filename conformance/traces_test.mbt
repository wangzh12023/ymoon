///|
test "differential: yjs reference traces" {
  let path = "oracle/out/traces.jsonl"
  guard @fs.path_exists(path) else {
    // traces are generated by `node oracle/gen-traces.mjs`; skip if absent
    return
  }
  let content = @fs.read_file_to_string(path)
  let mut total = 0
  let mut checks = 0
  let failures : Array[String] = []
  for line in content.split("\n") {
    if line.is_empty() {
      continue
    }
    total += 1
    let r = @conformance.replay_trace(line) catch {
      e => {
        failures.push("trace #\{total - 1} raised \{e}")
        continue
      }
    }
    checks += r.checks
    match r.failure {
      Some(msg) => failures.push("trace \{r.id} (\{r.mode}): \{msg}")
      None => ()
    }
  }
  println(
    "differential traces: \{total - failures.length()}/\{total} passed, \{checks} byte-level checks",
  )
  if failures.length() > 0 {
    for f in failures[:@cmp.minimum(failures.length(), 5)] {
      println(f)
    }
    fail("\{failures.length()} traces diverged from yjs")
  }
}
